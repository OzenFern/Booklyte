<%- include("../partials/layout-start", { title, pageClass: "page-library" }) %>

<section class="page-intro">
  <p class="page-intro__kicker">Manual Link</p>
  <h1>Add Book to Library</h1>
  <p class="page-intro__lead">
    Use a local <code>book_id</code> to create a library entry.
  </p>
</section>

<section class="form-panel">
  <div id="library-form-container">
    <form action="/library" method="post" class="form-stack">
      <div class="form-field">
        <label for="book_id">Book ID</label>
        <input id="book_id" name="book_id" type="number" required min="1"
               placeholder="Enter a valid book ID"
               hx-get="/library/validate-book"
               hx-trigger="change, blur"
               hx-target="#book-id-validation"
               hx-indicator="#book-id-loading" />
        <div id="book-id-validation" class="form-validation"></div>
        <small class="form-hint">Enter the ID of an existing book from your collection</small>
        <span id="book-id-loading" class="htmx-indicator">Validating...</span>
      </div>

      <div class="form-field">
        <label for="status">Status</label>
        <select id="status" name="status" required>
          <option value="" disabled selected>Select a status</option>
          <option value="want_to_read">Want to Read</option>
          <option value="reading">Reading</option>
          <option value="completed">Completed</option>
          <option value="dropped">Dropped</option>
        </select>
      </div>

      <div class="cluster">
        <button type="submit" class="button button--solid">
          Add to Library
        </button>
        <a href="/library" class="button button--back">← Back to Library</a>
      </div>
    </form>
  </div>
</section>

<%- include("../partials/layout-end") %>
