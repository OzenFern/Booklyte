<%- include("../partials/layout-start", { title, pageClass: "page-library" }) %>

<section class="page-intro">
  <p class="page-intro__kicker">Manual Link</p>
  <h1>Add Book to Library</h1>
  <p class="page-intro__lead">
    Use a local <code>book_id</code> to create a library entry.
  </p>
</section>

<section class="form-panel">
  <form action="/library" method="post" class="form-stack">
    <div class="form-field">
      <label for="book_id">Book ID</label>
      <input id="book_id" name="book_id" type="number" required />
    </div>

    <div class="form-field">
      <label for="status">Status</label>
      <select id="status" name="status" required>
        <option value="want_to_read">Want to Read</option>
        <option value="reading">Reading</option>
        <option value="completed">Completed</option>
        <option value="dropped">Dropped</option>
      </select>
    </div>

    <div class="cluster">
      <button type="submit" class="button button--solid">Add to Library</button>
      <a href="/library" class="button button--ghost">Cancel</a>
    </div>
  </form>
</section>

<%- include("../partials/layout-end") %>
