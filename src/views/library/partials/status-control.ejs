<form
  action="/library/<%= libraryBook.library_book_id %>"
  method="post"
  hx-patch="/library/<%= libraryBook.library_book_id %>"
  hx-target="#library-book-<%= libraryBook.library_book_id %>"
  hx-swap="outerHTML"
>
  <label class="visually-hidden" for="status-<%= libraryBook.library_book_id %>">
    Reading status
  </label>
  <select
    id="status-<%= libraryBook.library_book_id %>"
    name="status"
    hx-trigger="change"
    class="status-select"
  >
    <option value="want_to_read" <%= libraryBook.status === "want_to_read" ? "selected" : "" %>>
      Want to Read
    </option>
    <option value="reading" <%= libraryBook.status === "reading" ? "selected" : "" %>>
      Reading
    </option>
    <option value="completed" <%= libraryBook.status === "completed" ? "selected" : "" %>>
      Completed
    </option>
    <option value="dropped" <%= libraryBook.status === "dropped" ? "selected" : "" %>>
      Dropped
    </option>
  </select>
</form>
