<%- include("../partials/layout-start", { title, pageClass: "page-reviews" }) %>

<section class="page-intro">
  <p class="page-intro__kicker">Review</p>
  <h1>Library Book Review</h1>
  <p class="page-intro__lead">Add or revise your notes for this library entry.</p>
  <div class="page-intro__actions">
    <a href="/library/<%= libraryBookId %>" class="button button--back">← Back to Library</a>
  </div>
</section>

<section id="review-panel" class="review-panel">
  <%- include("partials/review-panel", { review, libraryBookId, editMode: typeof editMode !== "undefined" && editMode === true }) %>
</section>

<%- include("../partials/layout-end") %>
