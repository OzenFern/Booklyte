<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title><%= title ? `${title} | Booklyte` : "Booklyte" %></title>
    <meta
      name="description"
      content="Booklyte is a lightweight personal reading tracker."
    />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@500;600;700&family=Space+Grotesk:wght@400;500;700&display=swap"
      rel="stylesheet"
    />
    <link rel="stylesheet" href="/css/main.css" />
    <script defer src="https://cdn.jsdelivr.net/npm/htmx.org@2.0.10/dist/htmx.min.js" integrity="sha384-H5SrcfygHmAuTDZphMHqBJLc3FhssKjG7w/CeCpFReSfwBWDTKpkzPP8c+cLsK+V" crossorigin="anonymous"></script>
    <script defer src="/js/main.js"></script>
  </head>
  <body class="<%= pageClass || '' %>">
    <a class="skip-link" href="#main-content">Skip to content</a>
    <div class="app-bg" aria-hidden="true"></div>

    <header class="site-header">
      <div class="container site-header__inner">
        <a class="site-logo" href="/">Booklyte</a>
        <%- include("navigation", { currentPath: typeof currentPath !== 'undefined' ? currentPath : '' }) %>
      </div>
    </header>

    <div class="container">
      <%- include("flash") %>
    </div>

    <main id="main-content" class="container page-shell">
