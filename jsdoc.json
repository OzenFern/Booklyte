{
  "source": {
    "include": ["src", "public/js"],
    "includePattern": ".+\\.js$",
    "excludePattern": "(^|\\/|\\\\)_"
  },
  "plugins": [],
  "opts": {
    "destination": "./docs/",
    "recurse": true,
    "template": "node_modules/modern-jsdoc-template/default",
    "readme": "./README.md"
  },
  "templates": {
    "default": {
      "includeDate": false,
      "outputSourceFiles": true
    }
  }
}
