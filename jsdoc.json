{
  "source": {
    "include": ["src", "public/js"],
    "includePattern": ".+\\.js$",
    "excludePattern": "(^|\\/|\\\\)_"
  },
  "plugins": [],
  "opts": {
    "destination": "./docs/",
    "recurse": true,
    "template": "modern-jsdoc-template/default"
  },
  "templates": {
    "default": {
      "includeDate": false
    }
  }
}
